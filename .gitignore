# Ignore temporary files and local credentials
__pycache__/
*.pyc
.env
service_account.json
gsc_credentials.json

# Explicitly allow JSON and TXT inside projects/nodus (overrides root .gitignore)
!*.json
!*.txt
!data/**
!content/**
!config/**
!dist/**

# Keep local raw chat scans and live GSC cache out of public git
data/field_notes/chat_empirical_digest.json
data/gsc_telemetry_live.json

data/analytics/
